{
  "name": "@applied-manifold/spatial-compiler",
  "version": "0.1.6",
  "description": "Local stdio MCP connector for the hosted Spatial Compiler: clean up generated GLB meshes with meshfx, plus pyrofx fire and smoke, geofx terrain, and shadowfx.",
  "license": "MIT",
  "author": "Applied Manifold",
  "homepage": "https://appliedmanifold.com",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "spatial-compiler",
    "applied-manifold",
    "glb",
    "mesh-repair",
    "lod",
    "uv-unwrap",
    "meshfx"
  ],
  "type": "module",
  "bin": {
    "spatial-compiler-mcp": "src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "skills",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node scripts/e2e.mjs",
    "test:oauth": "node scripts/oauth-mock.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "mcpName": "com.appliedmanifold/spatial-compiler",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/applied-manifold/mcp-npm.git"
  },
  "bugs": {
    "url": "https://github.com/applied-manifold/mcp-npm/issues"
  }
}
